import numpy as np

# 1. Creo un array con 12 valori equidistanti tra 0 e 1 utilizzando linspace
arr = np.linspace(0, 1, 12)
print("Array iniziale:")
print(arr,"\n")

# 2. Cambio la forma dell'array a una matrice 3x4
matrice = arr.reshape(3, 4)
print("\nMatrice 3x4:")
print(matrice,"\n")

# 3. Genero una matrice 3x4 di numeri casuali tra 0 e 1
casuale = np.random.rand(12)
print("\nMatrice casuale:")
print(casuale,"\n")

# 4. Calcola la somma degli elementi di entrambe le matrici
somma1 = np.sum(matrice)
somma2 = np.sum(casuale)

# Stampa i risultati
print("Matrice 1:\n", matrice,"\n")
print("Somma della matrice 1:", somma1,"\n")

print("\nMatrice 2:\n", casuale,"\n")
print("Somma della matrice 2:", somma2,"\n")
